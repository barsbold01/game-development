class_name Board
extends RefCounted

# =============================================================================
#  ТАЛБАЙ (худаг)
# =============================================================================
#  Энэ файлд ГРАФИК ОГТ БАЙХГҮЙ. Зөвхөн тоонууд.
#  Хэрэв энэ файл зөв ажиллаж байвал тоглоом чинь бэлэн болсон гэсэн үг —
#  үлдсэн нь зөвхөн дэлгэц дээр шоо зурах ажил.
#
#  Өгөгдлийн бүтэц:
#      cells[y][z][x]  →  -1 бол хоосон,  0..8 бол тухайн өнгөтэй шоо
#
#  Яагаад [y] эхэлж байгаа вэ?
#      Учир нь бараг бүх үйлдэл нь "нэг тогтсон өндөрт юу байна вэ" гэдгээс
#      эхэлдэг — дүүрсэн мөр хайх, таталцал бодох гэх мэт.
#      cells[y] гэж бичихэд тухайн өндрийн бүтэн хавтгай шууд гарч ирнэ.
# =============================================================================

var w: int  # өргөн   (x тэнхлэг)
var d: int  # гүн     (z тэнхлэг)
var h: int  # өндөр   (y тэнхлэг)

var cells: Array = []


func _init(width: int, depth: int, height: int) -> void:
	w = width
	d = depth
	h = height
	reset()


# Нэг хоосон давхарга (d x w хэмжээтэй хавтгай) үүсгэнэ
func _empty_layer() -> Array:
	var layer: Array = []
	for z in d:
		var row: Array = []
		row.resize(w)
		row.fill(-1)
		layer.append(row)
	return layer


func reset() -> void:
	cells = []
	for y in h:
		cells.append(_empty_layer())


# -----------------------------------------------------------------------------
#  МӨРГӨЛДӨӨН ШАЛГАХ — тоглоомын хамгийн чухал функц
# -----------------------------------------------------------------------------
#  Нэг нүд "чөлөөтэй" байх гэдэг нь:
#    1) хананы дотор байх (x, z хязгаарт)
#    2) шал ба тааз хоёрын хооронд байх (0 <= y < h)
#    3) тэнд өөр шоо байхгүй байх
#
#  ЧУХАЛ: талбайн дээд тал нь ХААЛТТАЙ (y >= h бол чөлөөтэй биш).
#  Эсрэг тохиолдолд эргэлтийн "kick" дүрсийг таазнаас дээш түлхэж,
#  түгжихэд массивын гадна үлдсэн шоонууд алга болно.
#  Дүрс төрөх үед бүхэлдээ дотор нь багтдаг тул энэ нь асуудал үүсгэхгүй.
# -----------------------------------------------------------------------------
func is_free(c: Vector3i) -> bool:
	if c.x < 0 or c.x >= w:
		return false
	if c.z < 0 or c.z >= d:
		return false
	if c.y < 0 or c.y >= h:
		return false
	return cells[c.y][c.z][c.x] == -1


# Тухайн дүрсийг тухайн байрлалд тавьж болох уу?
#   shape — харьцангуй offset-уудын жагсаалт
#   pos   — талбай дээрх абсолют байрлал
func can_place(shape: Array, pos: Vector3i) -> bool:
	for off in shape:
		if not is_free(pos + off):
			return false
	return true


# Дүрсийг талбайд бичиж "чулуужуулах"
func lock(shape: Array, pos: Vector3i, color_id: int) -> void:
	for off in shape:
		var c: Vector3i = pos + off
		if c.y >= 0 and c.y < h:
			cells[c.y][c.z][c.x] = color_id


# -----------------------------------------------------------------------------
#  ДҮҮРСЭН МӨР ОЛОХ
# -----------------------------------------------------------------------------
#  "Мөр" гэдэг нь НЭГ ТОГТСОН ӨНДӨРТ (y) байгаа шулуун эгнээ.
#  3D-д ийм эгнээ ХОЁР чиглэлд байна:
#
#     X-мөр :  y ба z тогтмол,  x = 0..w-1    →  w ширхэг нүд
#     Z-мөр :  y ба x тогтмол,  z = 0..d-1    →  d ширхэг нүд
#
#  Тиймээс нэг давхаргад нийт (d + w) ширхэг боломжит мөр байна.
#  5x5 талбайд бол 10 мөр — бүтэн давхарга (25 нүд) хүлээхээс хамаагүй олон
#  боломж гарна.
#
#  Функц нь мөр бүрийн НҮДНҮҮДИЙГ буцаана (зөвхөн дугаарыг биш), учир нь
#  дараа нь яг тэдгээр нүдийг устгах хэрэгтэй болно.
# -----------------------------------------------------------------------------
func find_full_rows() -> Array:
	var rows: Array = []
	for y in h:
		# --- X тэнхлэгийн дагуух мөрүүд ---
		for z in d:
			var ok_x: bool = true
			for x in w:
				if cells[y][z][x] == -1:
					ok_x = false
					break
			if ok_x:
				var row_x: Array = []
				for x in w:
					row_x.append(Vector3i(x, y, z))
				rows.append(row_x)

		# --- Z тэнхлэгийн дагуух мөрүүд ---
		for x in w:
			var ok_z: bool = true
			for z in d:
				if cells[y][z][x] == -1:
					ok_z = false
					break
			if ok_z:
				var row_z: Array = []
				for z in d:
					row_z.append(Vector3i(x, y, z))
				rows.append(row_z)
	return rows


# Заасан нүднүүдийг хоослох
func clear_cells(list: Array) -> void:
	for c in list:
		cells[c.y][c.z][c.x] = -1


# -----------------------------------------------------------------------------
#  ТАТАЛЦАЛ
# -----------------------------------------------------------------------------
#  Мөр устсаны дараа дээр нь агаарт өлгөөтэй шоонууд үлддэг.
#  Босоо багана (x, z) тус бүрийг дагуулж бүх шоог доош нь шахна.
#
#  Аргачлал: баганын бүх шоог доороос дээш нь жагсаалтад цуглуулаад,
#  дараа нь баганыг цэвэрлэж, жагсаалтаа доороос нь эхлүүлэн буцааж бичнэ.
#
#  Буцаах утга: ямар нэг шоо хөдөлсөн эсэх.
# -----------------------------------------------------------------------------
func apply_gravity() -> bool:
	var moved: bool = false
	for z in d:
		for x in w:
			var stack: Array = []
			for y in h:
				if cells[y][z][x] != -1:
					stack.append(cells[y][z][x])
			for y in h:
				var v: int = stack[y] if y < stack.size() else -1
				if cells[y][z][x] != v:
					moved = true
				cells[y][z][x] = v
	return moved


# Талбай дээрх нийт шооны тоо (гинжин урвалын тооцоонд хэрэгтэй)
func block_count() -> int:
	var n: int = 0
	for y in h:
		for z in d:
			for x in w:
				if cells[y][z][x] != -1:
					n += 1
	return n


# Хамгийн өндөр эзлэгдсэн давхарга (HUD-д ашиглана)
func stack_height() -> int:
	for y in range(h - 1, -1, -1):
		for z in d:
			for x in w:
				if cells[y][z][x] != -1:
					return y + 1
	return 0
