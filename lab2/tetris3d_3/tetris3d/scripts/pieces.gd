	[Vector3i(-1, 0, 0), Vector3i(0, 0, 0), Vector3i(1, 0, 0), Vector3i(-1, 0, 1)],

	# 4 — S
	[Vector3i(0, 0, 0), Vector3i(1, 0, 0), Vector3i(-1, 0, 1), Vector3i(0, 0, 1)],

	# 5 — T
	[Vector3i(-1, 0, 0), Vector3i(0, 0, 0), Vector3i(1, 0, 0), Vector3i(0, 0, 1)],

	# --- Доорхи 3 нь ЖИНХЭНЭ 3D дүрснүүд: хавтгайд багтдаггүй ---

	# 6 — Tripod : гурван тэнхлэг рүү сарвайсан булан
	[Vector3i(0, 0, 0), Vector3i(1, 0, 0), Vector3i(0, 0, 1), Vector3i(0, 1, 0)],

