# =============================================================================
#  ЭРГЭЛТ
# =============================================================================
#  90 градусын эргэлт бол зүгээр л координат солих + тэмдэг солих үйлдэл.
#  Синус, косинус, матриц ОГТ хэрэггүй. Бүх утга бүхэл тоо хэвээр үлддэг
#  учраас бөөрөнхийлөх алдаа гарахгүй — энэ нь тор дээрх тоглоомд маш чухал.
# =============================================================================

# X тэнхлэгийн эргэн тойронд 90°  (дүрс урагш хөмөрнө)
static func _rot_x(c: Vector3i) -> Vector3i:
	return Vector3i(c.x, -c.z, c.y)

# Y тэнхлэгийн эргэн тойронд 90°  (дүрс хэвтээгээр эргэнэ)
static func _rot_y(c: Vector3i) -> Vector3i:
	return Vector3i(c.z, c.y, -c.x)

# Z тэнхлэгийн эргэн тойронд 90°  (дүрс хажуу тийшээ хөмөрнө)
static func _rot_z(c: Vector3i) -> Vector3i:
	return Vector3i(-c.y, c.x, c.z)


# Нэг удаа эргүүлэх. axis нь (1,0,0), (0,1,0) эсвэл (0,0,1) байна.
static func _rotate_once(shape: Array, axis: Vector3i) -> Array:
	var out: Array = []
	for c in shape:
		if axis.x != 0:
			out.append(_rot_x(c))
		elif axis.y != 0:
			out.append(_rot_y(c))
		else:
			out.append(_rot_z(c))
	return out


# Дурын тэнхлэгийн (сөрөг чиглэл ч бас) эргэн тойронд эргүүлэх.
#   Сөрөг тэнхлэг рүү 90° эргэх  ==  эерэг тэнхлэг рүү 3 удаа 90° эргэх
static func rotate(shape: Array, axis: Vector3i) -> Array:
	var base: Vector3i = axis
	var times: int = 1
	if axis.x + axis.y + axis.z < 0:
		base = -axis
		times = 3

	var out: Array = shape.duplicate()
	for i in times:
		out = _rotate_once(out, base)
	return out
