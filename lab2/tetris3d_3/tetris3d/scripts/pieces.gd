class_name Pieces
extends RefCounted

# =============================================================================
#  ДҮРСНҮҮД
# =============================================================================
#  Дүрс бүр нь Vector3i-уудын ЖАГСААЛТ.
#  Тэдгээр нь АБСОЛЮТ байрлал БИШ, харин дүрсний "төв"-өөс хэдэн нүд
#  зөрүүтэй вэ гэдгийг заасан ХАРЬЦАНГУЙ утга (offset) юм.
#
#  Тэнхлэгүүд:  x = зүүн/баруун,  y = дээш/доош,  z = урд/хойд
#
#  Жишээ нь I-дүрсийг авч үзье:
#      [(-1,0,0), (0,0,0), (1,0,0), (2,0,0)]
#  Энэ нь x тэнхлэгийн дагуу дараалсан 4 шоо гэсэн үг.
#  Хэрэв дүрсний байрлал (pos) нь (3, 10, 3) бол бодит нүднүүд нь:
#      (2,10,3), (3,10,3), (4,10,3), (5,10,3)
#  болно. Өөрөөр хэлбэл:  бодит нүд = pos + offset
# =============================================================================

const SHAPES: Array = [
